# Copy to .env and fill in what you need. Never commit .env.
# Everything works without any key: the app falls back to the labelled offline scaffold engine.

# --- Claude (Anthropic) — enables AI strategy, research synthesis, drafting and QA judgement
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown)
CSA_MODEL_STRONG=claude-opus-5-5
CSA_MODEL_FAST=claude-haiku-5-5
# Optional: only set if you route through a gateway. Leave blank for api.anthropic.com
CSA_ANTHROPIC_BASE_URL=

# --- Server
PORT=8787
# Bind address. Keep 127.0.0.1 for local-first use; the API has no login.
HOST=127.0.0.1
CSA_DB_PATH=data/throughline.sqlite

# --- Secrets at rest (OAuth tokens, provider keys saved from the UI)
# 64 hex chars. If blank, a key is generated at data/secret.key (keep it out of backups you share).
CSA_SECRET_KEY=

# --- Platform OAuth (not required for core use; see docs/INTEGRATIONS.md)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
